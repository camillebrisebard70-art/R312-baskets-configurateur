---
import BasketProfil from "./BasketProfil.astro";
import BasketDessus from "./BasketDessus.astro";
import db from "../lib/db.js";

interface Props {
  id: number;
  description: string;
  semelle: string;
  empeigne: string;
  pointe: string;
  oeillet: string;
  bande: string;
  languette: string;
  lacet: string;
  trimestre: string;
}

const { id, semelle, empeigne, pointe, oeillet, bande, languette, lacet, trimestre } = Astro.props;
let { description } = Astro.props;

let configuration_basket = { semelle, empeigne, pointe, oeillet, bande, languette, lacet, trimestre };

// On garde une copie des couleurs de départ, pour le bouton "Réinitialiser"
const configuration_de_depart = { ...configuration_basket };

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  description = formData.get("description")?.toString() ?? "";

  configuration_basket = {
    semelle: formData.get("semelle")?.toString() ?? "#ffffff",
    empeigne: formData.get("empeigne")?.toString() ?? "#ffffff",
    pointe: formData.get("pointe")?.toString() ?? "#ffffff",
    oeillet: formData.get("oeillet")?.toString() ?? "#ffffff",
    bande: formData.get("bande")?.toString() ?? "#ffffff",
    languette: formData.get("languette")?.toString() ?? "#ffffff",
    lacet: formData.get("lacet")?.toString() ?? "#ffffff",
    trimestre: formData.get("trimestre")?.toString() ?? "#ffffff",
  };

  db.run(
  `UPDATE BASKETS
   SET description = ?, semelle = ?, empeigne = ?, pointe = ?, oeillet = ?,
       bande = ?, languette = ?, lacet = ?, trimestre = ?
   WHERE id = ? AND user_id = ?`,
  [
    description, configuration_basket.semelle, configuration_basket.empeigne,
    configuration_basket.pointe, configuration_basket.oeillet, configuration_basket.bande,
    configuration_basket.languette, configuration_basket.lacet, configuration_basket.trimestre,
    id, Astro.locals.user!.id,
  ],
);
}
---

<div
  class="configurateur flex flex-col items-center gap-6 p-4"
  data-configuration-defaut={JSON.stringify(configuration_de_depart)}
>
  <div class="flex flex-wrap justify-center gap-4">
    <BasketProfil {...configuration_basket} />
    <BasketDessus {...configuration_basket} />
  </div>

  <form method="POST" action={`/baskets/${id}`} class="flex flex-col items-center gap-4">
    <input
      type="text"
      name="description"
      value={description}
      placeholder="Nom de la basket"
      class="input input-bordered w-full max-w-xs"
    />
    <div class="flex flex-wrap items-center justify-center gap-4 py-2">
      {Object.entries(configuration_basket).map(([partie, couleur]) => (
        <div class="flex flex-col items-center">
          <label for={partie} class="text-sm font-medium capitalize">{partie}</label>
          <input type="color" id={partie} name={partie} value={couleur} class="cursor-pointer" />
        </div>
      ))}
    </div>

    <div class="flex gap-4">
      <button
        type="submit"
        class="border-2 border-green-600 bg-green-600 text-white rounded-lg px-4 py-2 font-semibold hover:bg-green-700 transition-colors cursor-pointer"
      >
        Enregistrer la configuration
      </button>

      <button
        type="button"
        class="reinitialiser border-2 border-black rounded-lg px-4 py-2 font-semibold hover:bg-black hover:text-white transition-colors cursor-pointer"
      >
        Réinitialiser les couleurs
      </button>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".configurateur").forEach((configurateur) => {
    const configurationDefaut: Record<string, string> = JSON.parse(configurateur.dataset.configurationDefaut ?? "{}");
    const inputs = configurateur.querySelectorAll<HTMLInputElement>('input[type="color"]');

    const colorier = (partie: string, couleur: string) => {
      configurateur.querySelectorAll(`svg .${partie}`).forEach((element) => {
        element.setAttribute("fill", couleur);
      });
    };

    inputs.forEach((input) => {
      input.addEventListener("input", () => colorier(input.name, input.value));
    });

    configurateur.querySelector(".reinitialiser")?.addEventListener("click", () => {
      inputs.forEach((input) => {
        input.value = configurationDefaut[input.name];
        colorier(input.name, input.value);
      });
    });
  });
</script>