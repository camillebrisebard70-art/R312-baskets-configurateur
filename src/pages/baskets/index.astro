---
import Layout from "../../layouts/Layout.astro";
import BasketProfil from "../../components/BasketProfil.astro";
import db from "../../lib/db.js";
import type { Basket } from "../../lib/db.js";

const baskets: Basket[] = db
  .prepare("SELECT * FROM BASKETS WHERE user_id = ?")
  .all(Astro.locals.user!.id);
---

<Layout>
  <div class="p-4">
    <h1 class="text-2xl font-bold mb-6 text-center">Mes baskets</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {baskets.map((basket) => (
        <div class="card bg-base-100 shadow-md">
          <div class="card-body items-center text-center">
            <BasketProfil {...basket} />
            <h2 class="card-title">{basket.description || "Sans nom"}</h2>
            <div class="card-actions justify-center mt-2">
              <a href={`/baskets/${basket.id}`} class="btn btn-primary">Modifier</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>